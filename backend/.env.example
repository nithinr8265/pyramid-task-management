# Backend Environment Variables Example

# MongoDB Connection String (Prisma requires MongoDB replica set connection string)
DATABASE_URL="mongodb://root:examplepassword@localhost:27017/pyramid?authSource=admin&replicaSet=rs0"

# JWT Auth Secrets & Expiry
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Allowed CORS Origins (comma-separated if multiple)
CORS_ORIGIN="http://localhost:3001,http://localhost:3000"

# Application Port
PORT=3000
